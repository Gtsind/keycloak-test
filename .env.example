# Phase 1 infra has no secrets beyond compose defaults.
# Phase 2+ adds these for the user-service -> Keycloak admin client:
# KEYCLOAK_URL=http://keycloak:8080
# KEYCLOAK_REALM=aibydna
# KEYCLOAK_ADMIN_CLIENT_ID=user-service-client
# KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me
# Phase 4 adds JWT validation. If tokens are issued to browsers hitting
# http://localhost:8080, set the issuer explicitly; otherwise it's derived
# from KEYCLOAK_URL + realm.
# KEYCLOAK_ISSUER=http://localhost:8080/realms/aibydna
# APP_DB_URL=postgresql+asyncpg://app:app@app-postgres:5432/app
